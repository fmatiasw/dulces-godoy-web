  <p style="font-size:.74rem;">Sin sección de testimonios a propósito: se suma cuando haya comentarios reales de clientes para mostrar.</p>
</footer>

<script is:inline>
(function(){
  var PHONE = '5493794050585'; // WhatsApp real: 3794050585 (Corrientes)

  var quickBtn = document.getElementById('quickWhatsapp');
  if(quickBtn){
    quickBtn.href = 'https://wa.me/' + PHONE + '?text=' + encodeURIComponent('Hola! Quiero hacer un pedido de dulces Godoy.');
  }
  var temporadaBtn = document.getElementById('temporadaWhatsapp');
  if(temporadaBtn){
    temporadaBtn.href = 'https://wa.me/' + PHONE + '?text=' + encodeURIComponent('Hola! Quería consultar disponibilidad de higo, kinoto, guayaba o batatita.');
  }
  var mayoristaBtn = document.getElementById('mayoristaWhatsapp');
  if(mayoristaBtn){
    mayoristaBtn.href = 'https://wa.me/' + PHONE + '?text=' + encodeURIComponent('Hola! Quería consultar precios por mayor (baldes) o el growler de almíbar.');
  }

  // Precios reales, lista "Salón Ventas" (final, 15.06.26) — sin 40g, ya no se comercializa
  var SIZE_LABEL = {'250g':'250 g','465g':'465 g','850g':'850 g','1750g':'1,75 kg','3500g':'3,5 kg'};
  var PRICE_BASE = { '250g':7500, '465g':9960, '850g':16400, '1750g':36400, '3500g':60740 };
  var PRICE_MID  = { '250g':9760, '465g':12940, '850g':21320, '1750g':47320, '3500g':78960 };
  var PRICE_AGUAI = { '250g':11260, '465g':14940, '850g':24600, '1750g':54600, '3500g':91100 };
  var TIER_TABLE = {base:PRICE_BASE, mid:PRICE_MID, aguai:PRICE_AGUAI};

  // Precios por caja cerrada, lista "Supermercados" (final, 15.06.26) — se aplican por unidad
  // en cuanto la cantidad de ESE sabor+tamaño llega al tamaño de la caja.
  var PACK_SIZE = {'250g':12, '465g':12, '850g':9, '1750g':6, '3500g':4};
  var PRICE_BASE_BOX  = { '250g':5520, '465g':7320, '850g':12060, '1750g':26760, '3500g':44660 };
  var PRICE_MID_BOX   = { '250g':7170, '465g':9520, '850g':15680, '1750g':34790, '3500g':58060 };
  var PRICE_AGUAI_BOX = { '250g':8280, '465g':10980, '850g':18090, '1750g':40140, '3500g':66990 };
  var BOX_TABLE = {base:PRICE_BASE_BOX, mid:PRICE_MID_BOX, aguai:PRICE_AGUAI_BOX};

  var FLAVOR_LABEL = {
    mamon:'Mamón', zapallo:'Zapallo', lima:'Lima', naranja:'Naranja', aguai:'Aguaí',
    higo:'Higo', kinoto:'Kinoto', batatita:'Batatita', guayaba:'Guayaba'
  };
  var FLAVOR_TIER = {
    mamon:'base', zapallo:'base', lima:'base', naranja:'base',
    higo:'mid', kinoto:'mid', batatita:'mid', guayaba:'mid',
    aguai:'aguai'
  };
  var currentSize = '850g';
  var cart = {};
  var zone = 'local';

  // Solo se listan los tamaños de los que hay foto real. Si falta, la card muestra un color en vez de una imagen inventada.
  var PRODUCT_IMAGES = {
    mamon:    {'250g':'/images/products/mamon-250.jpg','465g':'/images/products/mamon-465.jpg','850g':'/images/products/mamon-850.jpg','3500g':'/images/products/mamon-3500.jpg'},
    zapallo:  {'250g':'/images/products/zapallo-250.jpg','465g':'/images/products/zapallo-465.jpg','850g':'/images/products/zapallo-850.jpg','3500g':'/images/products/zapallo-3500.jpg'},
    lima:     {'250g':'/images/products/lima-250.jpg','465g':'/images/products/lima-465.jpg','850g':'/images/products/lima-850.jpg'},
    aguai:    {'465g':'/images/products/aguai-465.jpg','850g':'/images/products/aguai-850.jpg'},
    naranja:  {'850g':'/images/products/naranja-850.jpg'},
    higo:     {'250g':'/images/products/higo-250.jpg','850g':'/images/products/higo-850.jpg'},
    kinoto:   {'465g':'/images/products/kinoto-465.jpg','850g':'/images/products/kinoto-850.jpg','3500g':'/images/products/kinoto-3500.jpg'},
    batatita: {'250g':'/images/products/batatita-250.jpg'},
    guayaba:  {}
  };
  var FLAVOR_COLOR = {
    mamon:'#e0763a', zapallo:'#c68a2e', lima:'#8a9a4a', naranja:'#d98a2c', aguai:'#c9a13a',
    higo:'#6b3654', kinoto:'#c9762e', batatita:'#a83d5a', guayaba:'#c65a4a'
  };

  function fmt(n){ return '$' + n.toLocaleString('es-AR'); }

  function isBoxQty(size, qty){
    return qty >= PACK_SIZE[size];
  }

  function priceForQty(flavor, size, qty){
    var tier = FLAVOR_TIER[flavor];
    var table = isBoxQty(size, qty) ? BOX_TABLE[tier] : TIER_TABLE[tier];
    return table[size];
  }

  function packHintEl(card){
    var priceDiv = card.querySelector('.fam-price');
    var hint = priceDiv.querySelector('.pack-hint');
    if(!hint){
      hint = document.createElement('span');
      hint.className = 'pack-hint';
      priceDiv.appendChild(hint);
    }
    return hint;
  }

  function updatePhoto(card){
    var flavor = card.getAttribute('data-flavor');
    var wrap = card.querySelector('.fam-photo-wrap');
    if(!wrap) return;
    var img = wrap.querySelector('.fam-photo');
    var path = (PRODUCT_IMAGES[flavor] || {})[currentSize];
    if(path){
      img.src = path;
      wrap.classList.remove('no-photo');
      wrap.style.background = '#fff';
    } else {
      wrap.classList.add('no-photo');
      wrap.style.background = FLAVOR_COLOR[flavor] || 'var(--accent)';
    }
  }

  function renderCards(){
    document.querySelectorAll('.fam-card').forEach(function(card){
      var flavor = card.getAttribute('data-flavor');
      var key = cardKey(card);
      var qty = cart[key] ? cart[key].qty : 0;
      var pack = PACK_SIZE[currentSize];
      var boxPrice = BOX_TABLE[FLAVOR_TIER[flavor]][currentSize];
      var amountEl = card.querySelector('.fam-price .amount');
      var noteEl = card.querySelector('.fam-price .note');
      amountEl.textContent = fmt(priceForQty(flavor, currentSize, qty));
      noteEl.textContent = 'frasco ' + SIZE_LABEL[currentSize];

      var hint = packHintEl(card);
      if(isBoxQty(currentSize, qty)){
        hint.textContent = '✓ Precio de caja aplicado (' + fmt(boxPrice) + ' c/u desde ' + pack + ' unidades)';
        hint.classList.add('pack-hint--active');
      } else {
        var falta = pack - qty;
        hint.textContent = 'Comprando ' + pack + ' (1 caja): ' + fmt(boxPrice) + ' c/u' + (qty > 0 ? ' · faltan ' + falta : '');
        hint.classList.remove('pack-hint--active');
      }

      updatePhoto(card);
      syncCardUI(card);
    });
  }

  document.querySelectorAll('.size-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.size-btn').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      currentSize = btn.getAttribute('data-size');
      renderCards();
    });
  });
  renderCards();

  var cartInner = document.getElementById('cartInner');
  var cartCount = document.getElementById('cartCount');
  var cartTotal = document.getElementById('cartTotal');
  var cartCta = document.getElementById('cartCta');

  function buildMessage(){
    var lines = ['Hola! Quiero pedir:'];
    var total = 0;
    var count = 0;
    Object.keys(cart).forEach(function(key){
      var item = cart[key];
      count += item.qty;
      total += item.qty * item.price;
      lines.push('- ' + item.qty + ' x Dulce de ' + item.label + ' (' + item.sizeLabel + ', ' + fmt(item.price) + ' c/u' + (item.isBox ? ', precio de caja' : '') + ')');
    });
    lines.push('');
    lines.push('Total: ' + fmt(total));
    lines.push(zone === 'local' ? 'Zona: Corrientes / Chaco (reparto propio o retiro en Maipú 1346)' : 'Zona: otra provincia (envío a todo el país)');
    return {text: lines.join('\n'), total: total, count: count};
  }

  function render(){
    var summary = buildMessage();
    if(summary.count > 0){
      cartInner.classList.add('show');
      cartCount.textContent = summary.count + (summary.count === 1 ? ' dulce' : ' dulces');
      cartTotal.textContent = fmt(summary.total);
      cartCta.href = 'https://wa.me/' + PHONE + '?text=' + encodeURIComponent(summary.text);
    } else {
      cartInner.classList.remove('show');
    }
  }

  function cardKey(card){
    return card.getAttribute('data-flavor') + '_' + currentSize;
  }

  function syncCardUI(card){
    var key = cardKey(card);
    var qty = cart[key] ? cart[key].qty : 0;
    var addBtn = card.querySelector('.add-btn');
    var stepper = card.querySelector('.stepper');
    if(qty > 0){
      addBtn.hidden = true;
      stepper.hidden = false;
      stepper.querySelector('.step-qty').textContent = qty;
    } else {
      addBtn.hidden = false;
      stepper.hidden = true;
    }
  }

  function changeQty(card, delta){
    var flavor = card.getAttribute('data-flavor');
    var key = cardKey(card);
    if(!cart[key]){
      cart[key] = {qty:0, price:0, label:FLAVOR_LABEL[flavor], sizeLabel:SIZE_LABEL[currentSize]};
    }
    cart[key].qty += delta;
    if(cart[key].qty <= 0){
      delete cart[key];
    } else {
      cart[key].price = priceForQty(flavor, currentSize, cart[key].qty);
      cart[key].isBox = isBoxQty(currentSize, cart[key].qty);
    }
    renderCards();
    render();
  }

  document.querySelectorAll('.fam-card').forEach(function(card){
    card.querySelector('.add-btn').addEventListener('click', function(){ changeQty(card, 1); });
    card.querySelector('.step-plus').addEventListener('click', function(){ changeQty(card, 1); });
    card.querySelector('.step-minus').addEventListener('click', function(){ changeQty(card, -1); });
  });

  document.querySelectorAll('.zone-toggle button').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.zone-toggle button').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      zone = btn.getAttribute('data-zone');
      var result = document.getElementById('zoneResult');
      if(zone === 'local'){
        result.innerHTML = '<strong>Zona de reparto propio.</strong> Coordinamos el día de entrega por WhatsApp, o retirás en Maipú 1346, Corrientes.';
      } else {
        result.innerHTML = '<strong>Enviamos a todo el país.</strong> Te confirmamos el courier, el costo y el plazo por WhatsApp al cerrar el pedido.';
      }
      render();
    });
  });

  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ e.target.classList.add('in-view'); }
    });
  }, {threshold:.2});
  document.querySelectorAll('.fam-card').forEach(function(el){ io.observe(el); });

  document.querySelectorAll('.reveal').forEach(function(el, i){
    el.style.transitionDelay = (i % 6) * 70 + 'ms';
    io.observe(el);
  });
})();
</script>
</body>
</html>
